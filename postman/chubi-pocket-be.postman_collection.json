    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const t = pm.response.json()?.token?.access_token;",
                  "  if (t) pm.environment.set('token', t);",
                  "  const uid = pm.response.json()?.user?.id;",
                  "  if (uid) pm.environment.set('userId', uid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"smoke1a\",\n  \"password\": \"testtest\",\n  \"display_name\": \"Smoke 1a\",\n  \"email\": \"smoke1a@example.com\",\n  \"currency\": \"THB\"\n}"
