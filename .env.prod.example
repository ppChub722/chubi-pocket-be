# Production environment for chubi-pocket-be (VPS, public-facing).
# Copy to .env on the prod VPS and fill in. NEVER commit the filled file.
#   cp .env.prod.example .env

# --- Domain (required: Caddy uses this for auto Let's Encrypt TLS) ---
# Must already point at this VPS's public IP via an A record.
# Example: api.chubipocket.com
DOMAIN=

# --- App env (controls Gin mode + log format) ---
# production = JSON logs + Gin release mode (required for prod)
APP_ENV=production

# --- Database ---
# Generate a strong password: openssl rand -base64 24
DB_USER=chubadmin
DB_PASSWORD=
DB_NAME=chubi_pocket_db

# --- JWT ---
# Generate: openssl rand -hex 32
# Rotating this invalidates every active session — pick once, keep stable.
JWT_SECRET=
JWT_EXPIRATION_HOURS=720

# --- HTTP server timeouts (seconds; defaults shown, uncomment to override) ---
# SERVER_READ_TIMEOUT=10
# SERVER_WRITE_TIMEOUT=10
# SERVER_IDLE_TIMEOUT=120

# --- App version check (modules/appversion; read at start — restart app after a change) ---
# The app sends its build number in X-App-Build. Builds older than MIN_APP_BUILD
# get 426 APP_OUTDATED on every /api/v1 route except GET /api/v1/app/version.
# No header (web, Postman, scripts) always passes. 0 = check off.
MIN_APP_BUILD=0
# Newest build out there — the app shows a soft "update available" when behind.
LATEST_APP_BUILD=0
# Where testers download the APK (Firebase App Distribution tester link).
APP_DOWNLOAD_URL=
# Optional text for the update screen.
# APP_UPDATE_MESSAGE_TH=
# APP_UPDATE_MESSAGE_EN=

# --- Telegram bot (0.4.2, modules/telegram; read at start) ---
# Webhook only. Empty token = the bot is off (no route, nothing started).
# Token from @BotFather: never in git / chat / logs.
TELEGRAM_BOT_TOKEN=
# 1-256 chars of A-Z a-z 0-9 _ - (e.g. openssl rand -hex 32). Telegram sends it in
# X-Telegram-Bot-Api-Secret-Token on every call; a wrong / missing one gets 401.
TELEGRAM_WEBHOOK_SECRET=
# Set with setWebhook on start (allowed_updates = message). Empty = not set.
# Prod: https://chubipocket-api.ppforge.dev/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Who may use the bot = the chats linked from the app (profile → Telegram); no allow-list (0.4.2 1b).
