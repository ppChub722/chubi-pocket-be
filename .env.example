# Copy to .env and adjust. .env is gitignored.

# --- Application ---
APP_NAME=chubipocket
APP_ENV=development
APP_PORT=8080

# --- Database ---
# DB_HOST=db when running everything in compose; localhost when running `go run` from host.
DB_HOST=localhost
DB_PORT=5432
DB_USER=chubadmin
DB_PASSWORD=admin1234
DB_NAME=chubi_pocket_db
DB_SSLMODE=disable

# --- Registration gate ---
# false = closed registration that doesn't reveal itself: POST /auth/register
# runs the full flow, skips the DB write, and returns a decoy success.
# Set false on the public VPS; keep true for local dev.
REGISTRATION_OPEN=true

# --- Logging (phase dials — see chubi-pocket-docs/engineering/logging-plan.md) ---
# LOG_LEVEL: debug|info|warn|error. Unset = debug in development, info otherwise.
# Closed beta: debug. Wider beta: info. Production: warn.
LOG_LEVEL=debug
# true = HTTP log includes request/response JSON bodies (redacted, capped at 4KB).
# Closed beta ONLY — set false from wider beta onward. Default false.
LOG_BODIES=true

# --- JWT (Phase 0/1: 30-day single access token; Phase 2 splits into 15min + 7day refresh) ---
JWT_SECRET=local-secret-key-change-in-production
JWT_EXPIRATION_HOURS=720

# --- HTTP server timeouts (seconds) ---
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=120
