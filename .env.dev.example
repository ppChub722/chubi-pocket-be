# Dev environment for chubi-pocket-be (VPS, internal-use only).
# Copy to .env on the dev VPS and fill in. NEVER commit the filled file.
#   cp .env.dev.example .env

# --- Domain (required for HTTPS via Caddy auto Let's Encrypt) ---
# Use a free DuckDNS subdomain for dev: https://www.duckdns.org
# Example: chubipocket-dev.duckdns.org
DOMAIN=

# --- App env (controls Gin mode + log format) ---
# development = verbose text logs + Gin debug mode (more useful errors)
# production  = JSON logs + Gin release mode
APP_ENV=development

# --- Database ---
# Generate a strong password: openssl rand -base64 24
DB_USER=chubadmin
DB_PASSWORD=
DB_NAME=chubi_pocket_db

# --- JWT ---
# Generate: openssl rand -hex 32
# Rotating this invalidates every active session — pick once, keep stable.
JWT_SECRET=
JWT_EXPIRATION_HOURS=720

# --- HTTP server timeouts (seconds; defaults shown, uncomment to override) ---
# SERVER_READ_TIMEOUT=10
# SERVER_WRITE_TIMEOUT=10
# SERVER_IDLE_TIMEOUT=120

# --- App version check (modules/appversion; read at start — restart app after a change) ---
# The app sends its build number in X-App-Build. Builds older than MIN_APP_BUILD
# get 426 APP_OUTDATED on every /api/v1 route except GET /api/v1/app/version.
# No header (web, Postman, scripts) always passes. 0 = check off.
MIN_APP_BUILD=0
# Newest build out there — the app shows a soft "update available" when behind.
LATEST_APP_BUILD=0
# Where testers download the APK (Firebase App Distribution tester link).
APP_DOWNLOAD_URL=
# Optional text for the update screen.
# APP_UPDATE_MESSAGE_TH=
# APP_UPDATE_MESSAGE_EN=
