# =========================================================
# FinaBBear Configuration Template
# usage: Copy this file to root as .env and update values
# =========================================================

# --- Application Settings ---
APP_NAME=FinaBBear
APP_ENV=development
APP_PORT=8080

# --- Database Configuration ---
# Update these to match your local Docker/Postgres credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=chubadmin
DB_PASSWORD=your_password_here
DB_NAME=finna_bbear_db
DB_SSLMODE=disable

# --- Security (JWT) ---
# ⚠️ CRITICAL: Change this secret in production!
JWT_SECRET=change_me_to_something_long_and_random
JWT_EXPIRATION_HOURS=24

# --- Server Timeouts (Seconds) ---
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=120